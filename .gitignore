# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-integrated/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the env template visible even though .env* is ignored
!.env.example

# python extraction env (lives only under scripts/extract)
scripts/extract/.venv/
__pycache__/

# downloaded law corpus (large binaries, versioned by the downloader itself)
/corpus/

# extracted text (regenerable from corpus/)
/corpus-text/
.gstack/
