# GSTPilot environment variables.
# Copy this file to .env and fill in real values. .env is git-ignored — secrets never enter version control.

# --- Supabase (database: Postgres + pgvector) ---
# Project URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=
# Service-role key (server-only, bypasses row-level security — NEVER expose to the browser):
# Project Settings → API keys → service_role (may be labeled "secret" / start with sb_secret_)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (used only by scripts like pnpm migrate):
# Dashboard → Connect → Session pooler URI
DATABASE_URL=

# --- Anthropic (the language models) ---
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# --- Langfuse (observability: traces every model call so we can debug and eval) ---
# cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
