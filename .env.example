# Local, provider-free development. Copy to .env.local (git-ignored).
# Create a fresh PostgreSQL database from the reviewed migrations as an administrator,
# then use a separate DML-only runtime role. Never point this template at an old database.
DATABASE_URL=
DATABASE_NAME=gstpilot_local
DATABASE_SSL=disable
DATABASE_SSL_CA_FILE=

# Generate a new random secret of at least 32 characters; keep it outside version control.
AUTH_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000

# Explicit loopback-only preview: DB host must also be loopback and provider keys absent.
GSTPILOT_LOCAL_PREVIEW=1
GSTPILOT_BIND_HOST=127.0.0.1
GSTPILOT_MOCK_MODE=1
GSTPILOT_RETRIEVAL_MODE=keyword

# Ordinary live text provider; the prepared example stays free in either mode.
GSTPILOT_PROVIDER=openai
GSTPILOT_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional explicitly selected adapter: GSTPILOT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Lifetime included-usage limits, persisted in this application's database.
GSTPILOT_OWNER_BUDGET_USD=0.25
GSTPILOT_SHARED_BUDGET_USD=2

# External trace export is disabled by default. No account data is sent to these systems.
LANGFUSE_ENABLED=false
BLINDSPOT_ENABLED=false

# Production must use exact HTTPS PUBLIC_ORIGIN/AUTH_URL, NODE_ENV=production,
# GSTPILOT_MOCK_MODE=0, a CA-verified PostgreSQL connection and the configured key.
# Remove GSTPILOT_LOCAL_PREVIEW and DATABASE_SSL=disable; mount the trusted CA file.
# Supabase URLs/keys and remote embeddings are not used by the deployed runtime.
